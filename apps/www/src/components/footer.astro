---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";
---

<footer class="p-10 border-t border-gray-200 grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-10">
  <div class="flex flex-col gap-2">
    <Image src={logo} alt="Logo" class="h-6 w-min object-contain invert" />
    <div class="text-xs text-gray-500">&copy; 2025 JXD Ltd</div>
  </div>
  <div class="text-right">
    <div class="text-sm font-medium text-gray-700">Packages</div>
    <ul class="text-sm">
      <li>
        <a href="https://www.npmjs.com/package/@buildhype/react" target="_blank">React</a>
      </li>
      <li>
        <a href="https://www.npmjs.com/package/@buildhype/svelte">Svelte</a>
      </li>
      <li>
        <a href="https://www.npmjs.com/package/@buildhype/better-auth">Better Auth</a>
      </li>
    </ul>
  </div>
</footer>
